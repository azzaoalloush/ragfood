# Upstash Vector Configuration
# Get these values from https://console.upstash.com/
UPSTASH_VECTOR_REST_URL=https://your-region-your-id.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token_here

# LLM Configuration - Choose one:

# Option 1: Local Ollama (Default, Free)
# Make sure Ollama is running locally on port 11434
# No configuration needed - just have Ollama running

# Option 2: Groq Cloud (High Performance, Pay per use)
# Get API key from https://console.groq.com/keys
# Set to 'true' to use Groq instead of local Ollama
USE_GROQ=false
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative Groq models:
# llama-3.1-8b-instant (faster, cheaper)
# gpt-oss-120b (more capable)
# gpt-oss-20b (best price/performance)
